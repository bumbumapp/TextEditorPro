<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/home_card" />
            <corners android:radius="20dp" />
            <stroke android:width="2dp" android:color="@color/home_hero" />
        </shape>
    </item>
    <item>
        <ripple android:color="@color/home_card_pressed">
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/home_card" />
                    <corners android:radius="20dp" />
                    <stroke android:width="1dp" android:color="@color/home_divider" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
