<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/home__greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_greeting_morning"
            android:textColor="@color/home_text_dim"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/home_title"
            android:textColor="@color/home_text"
            android:textSize="30sp"
            android:fontFamily="@font/jakarta_extrabold" />

        <LinearLayout
            android:id="@+id/home__new_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/home_hero_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="112dp"
            android:orientation="horizontal"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_new_note"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:fontFamily="@font/jakarta_extrabold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/home_new_note_sub"
                    android:textColor="#D9FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_home_note_add" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/home__tile_todo"
                style="@style/HomeTile"
                android:layout_marginEnd="6dp">

                <ImageView
                    style="@style/HomeTileIcon"
                    android:background="@drawable/home_sq_green"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_assignment_turned_in_black_24dp"
                    android:tint="@color/home_fg_green" />

                <TextView
                    style="@style/HomeTileLabel"
                    android:text="@string/todo" />

                <TextView
                    style="@style/HomeTileSub"
                    android:text="@string/home_todo_sub" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/home__tile_quicknote"
                style="@style/HomeTile"
                android:layout_marginStart="6dp">

                <ImageView
                    style="@style/HomeTileIcon"
                    android:background="@drawable/home_sq_orange"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_lightning_black_24dp"
                    android:tint="@color/home_fg_orange" />

                <TextView
                    style="@style/HomeTileLabel"
                    android:text="@string/quicknote" />

                <TextView
                    style="@style/HomeTileSub"
                    android:text="@string/home_quicknote_sub" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/home__tile_markdown"
                style="@style/HomeTile"
                android:layout_marginEnd="6dp">

                <ImageView
                    style="@style/HomeTileIcon"
                    android:background="@drawable/home_sq_violet"
                    android:importantForAccessibility="no"
                    android:src="@drawable/gs_markdown_black_24dp"
                    android:tint="@color/home_fg_violet" />

                <TextView
                    style="@style/HomeTileLabel"
                    android:text="@string/home_markdown" />

                <TextView
                    style="@style/HomeTileSub"
                    android:text="@string/home_markdown_sub" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/home__tile_search"
                style="@style/HomeTile"
                android:layout_marginStart="6dp">

                <ImageView
                    style="@style/HomeTileIcon"
                    android:background="@drawable/home_sq_blue"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search_black_24dp"
                    android:tint="@color/home_fg_blue" />

                <TextView
                    style="@style/HomeTileLabel"
                    android:text="@string/search" />

                <TextView
                    style="@style/HomeTileSub"
                    android:text="@string/home_search_sub" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp"
            android:text="@string/home_recent_files"
            android:textColor="@color/home_text"
            android:textSize="17sp"
            android:fontFamily="@font/jakarta_extrabold" />

        <LinearLayout
            android:id="@+id/home__recent_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/home_card_bg"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </LinearLayout>
</ScrollView>
