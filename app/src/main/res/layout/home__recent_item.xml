<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/home__item_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/home_sq_violet"
        android:importantForAccessibility="no"
        android:padding="9dp"
        android:src="@drawable/ic_insert_drive_file_black_24dp"
        android:tint="@color/home_fg_violet" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/home__item_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/home_text"
            android:textSize="15sp"
            android:fontFamily="@font/jakarta_bold" />

        <TextView
            android:id="@+id/home__item_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/home_text_dim"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
