<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:background="@color/background"
    android:orientation="vertical">

    <include layout="@layout/tool__header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/tool_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/ToolSmallLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/cp_original" />

                    <TextView
                        android:id="@+id/cp_paste_a"
                        style="@style/ToolSmallLabel"
                        android:padding="8dp"
                        android:text="@string/tool_paste"
                        android:textColor="@color/home_fg_violet" />
                </LinearLayout>

                <EditText
                    android:id="@+id/cp_a"
                    style="@style/ToolInput"
                    android:hint="@string/cp_hint_a"
                    android:minHeight="88dp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/cp_swap"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/home_sq_violet"
                android:contentDescription="@string/cp_swap"
                android:padding="11dp"
                android:src="@drawable/ic_tool_swap"
                android:tint="@color/home_fg_violet" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/tool_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/ToolSmallLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/cp_changed" />

                    <TextView
                        android:id="@+id/cp_paste_b"
                        style="@style/ToolSmallLabel"
                        android:padding="8dp"
                        android:text="@string/tool_paste"
                        android:textColor="@color/home_fg_violet" />
                </LinearLayout>

                <EditText
                    android:id="@+id/cp_b"
                    style="@style/ToolInput"
                    android:hint="@string/cp_hint_b"
                    android:minHeight="88dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cp_result_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/tool_card"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:fontFamily="@font/jakarta_extrabold"
                    android:text="@string/cp_result"
                    android:textColor="@color/home_text"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/cp_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="@font/jakarta_bold"
                    android:textColor="@color/home_text_dim"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/cp_diff"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:paddingStart="16dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/home_text"
                    android:textDirection="ltr"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/tool_bar_bg"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <net.gsantner.markor.tools.IconTextButton
            android:id="@+id/cp_copy"
            style="@style/ToolBtn.Icon"
            android:drawableStart="@drawable/ic_tool_copy"
            android:drawableTint="@color/home_text"
            android:contentDescription="@string/tool_copy" />

        <net.gsantner.markor.tools.IconTextButton
            android:id="@+id/cp_compare"
            style="@style/ToolBtn.Primary"
            android:layout_marginStart="8dp"
            android:drawableStart="@drawable/ic_tool_swap"
            android:drawableTint="#FFFFFF"
            android:text="@string/cp_compare" />
    </LinearLayout>
</LinearLayout>
