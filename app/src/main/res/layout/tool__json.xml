<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:background="@color/background"
    android:orientation="vertical">

    <include layout="@layout/tool__header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/tool_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/ToolSmallLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/js_input" />

                    <TextView
                        android:id="@+id/js_sample"
                        style="@style/ToolSmallLabel"
                        android:padding="8dp"
                        android:text="@string/js_sample"
                        android:textColor="@color/home_fg_violet" />

                    <TextView
                        android:id="@+id/js_paste"
                        style="@style/ToolSmallLabel"
                        android:layout_marginStart="4dp"
                        android:padding="8dp"
                        android:text="@string/tool_paste"
                        android:textColor="@color/home_fg_violet" />

                    <TextView
                        android:id="@+id/js_clear"
                        style="@style/ToolSmallLabel"
                        android:layout_marginStart="4dp"
                        android:padding="8dp"
                        android:text="@string/tool_clear"
                        android:textColor="@color/home_fg_violet" />
                </LinearLayout>

                <EditText
                    android:id="@+id/js_input"
                    style="@style/ToolInput"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:hint="@string/js_hint"
                    android:minHeight="120dp"
                    android:textDirection="ltr"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/js_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/tool_pill_ok"
                android:drawablePadding="10dp"
                android:drawableStart="@drawable/ic_tool_check"
                android:drawableTint="@color/tool_ok_fg"
                android:fontFamily="@font/jakarta_bold"
                android:gravity="center_vertical"
                android:minHeight="52dp"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp"
                android:text="@string/js_status_idle"
                android:textColor="@color/tool_ok_fg"
                android:textSize="13sp" />

            <net.gsantner.markor.tools.FlowLayout
                android:id="@+id/js_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <net.gsantner.markor.tools.FlowLayout
                android:id="@+id/js_indents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/tool_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/ToolSmallLabel"
                    android:text="@string/js_output" />

                <TextView
                    android:id="@+id/js_output"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:minHeight="96dp"
                    android:textColor="@color/home_text"
                    android:textDirection="ltr"
                    android:textIsSelectable="true"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/tool__actions" />
</LinearLayout>
