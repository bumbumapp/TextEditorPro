<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:background="@color/background"
    android:orientation="vertical">

    <include layout="@layout/tool__header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/tool_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/ToolSmallLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/tt_your_text" />

                    <TextView
                        android:id="@+id/tt_paste"
                        style="@style/ToolSmallLabel"
                        android:padding="8dp"
                        android:text="@string/tool_paste"
                        android:textColor="@color/home_fg_violet" />

                    <TextView
                        android:id="@+id/tt_clear"
                        style="@style/ToolSmallLabel"
                        android:layout_marginStart="4dp"
                        android:padding="8dp"
                        android:text="@string/tool_clear"
                        android:textColor="@color/home_fg_violet" />
                </LinearLayout>

                <EditText
                    android:id="@+id/tt_input"
                    style="@style/ToolInput"
                    android:layout_marginTop="4dp"
                    android:hint="@string/tt_hint"
                    android:minHeight="132dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/ToolStatTile"
                    android:layout_marginEnd="4dp">

                    <TextView
                        android:id="@+id/tt_stat_words"
                        style="@style/ToolStatValue"
                        android:text="0" />

                    <TextView
                        style="@style/ToolStatLabel"
                        android:text="@string/tt_words" />
                </LinearLayout>

                <LinearLayout
                    style="@style/ToolStatTile"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp">

                    <TextView
                        android:id="@+id/tt_stat_chars"
                        style="@style/ToolStatValue"
                        android:text="0" />

                    <TextView
                        style="@style/ToolStatLabel"
                        android:text="@string/tt_chars" />
                </LinearLayout>

                <LinearLayout
                    style="@style/ToolStatTile"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp">

                    <TextView
                        android:id="@+id/tt_stat_lines"
                        style="@style/ToolStatValue"
                        android:text="0" />

                    <TextView
                        style="@style/ToolStatLabel"
                        android:text="@string/tt_lines" />
                </LinearLayout>

                <LinearLayout
                    style="@style/ToolStatTile"
                    android:layout_marginStart="4dp">

                    <TextView
                        android:id="@+id/tt_stat_read"
                        style="@style/ToolStatValue"
                        android:text="0" />

                    <TextView
                        style="@style/ToolStatLabel"
                        android:text="@string/tt_reading" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/ToolSection"
                    android:layout_width="0dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="0dp"
                    android:layout_weight="1"
                    android:text="@string/tt_transform" />

                <TextView
                    android:id="@+id/tt_undo"
                    style="@style/ToolSmallLabel"
                    android:alpha="0.4"
                    android:drawableStart="@drawable/ic_tool_undo"
                    android:drawablePadding="6dp"
                    android:drawableTint="@color/home_fg_violet"
                    android:gravity="center_vertical"
                    android:minHeight="40dp"
                    android:text="@string/tool_undo"
                    android:textColor="@color/home_fg_violet" />
            </LinearLayout>

            <TextView
                style="@style/ToolSmallLabel"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:text="@string/tt_group_case" />

            <net.gsantner.markor.tools.FlowLayout
                android:id="@+id/tt_chips_case"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/ToolSmallLabel"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:text="@string/tt_group_lines" />

            <net.gsantner.markor.tools.FlowLayout
                android:id="@+id/tt_chips_lines"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/tool_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jakarta_extrabold"
                    android:text="@string/tt_top_words"
                    android:textColor="@color/home_text"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/tt_words_empty"
                    style="@style/ToolSmallLabel"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/jakarta_medium"
                    android:text="@string/tt_no_words"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/tt_words_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/tool__actions" />
</LinearLayout>
