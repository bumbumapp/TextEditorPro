<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <style name="AppTheme.Unified.StartupFlash" parent="AppTheme.Unified">
        <item name="android:windowBackground">@color/dark__background</item>
    </style>

    <style name="AppTheme.Unified" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="android:windowActionModeOverlay">true</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="windowActionBarOverlay">true</item>
        <item name="android:windowActionBarOverlay">true</item>
        <item name="windowNoTitle">true</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="windowActionBar">false</item>
        <item name="android:fontFamily">@font/fontss</item>
        <item name="textColorAlertDialogListItem">@color/white</item>
        <item name="android:actionButtonStyle">@style/LessSpaceActionButtonStyle</item>
        <item name="preferenceTheme">@style/AppTheme.PreferenceTheme</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="android:actionModeBackground">@color/primary_dark</item>
        <item name="actionModeBackground">@color/primary_dark</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorBackgroundFloating">@color/primary</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:itemBackground">@color/primary</item>
    </style>



<style name="PopupMenu" parent="@android:style/Widget.PopupMenu">
<item name="android:popupBackground">@android:color/white</item>
</style>
    <style name="AppTheme.PreferenceTheme" parent="PreferenceThemeOverlay.v14.Material">
        <item name="preferenceCategoryStyle">@style/AppTheme.PreferenceTheme.CategoryStyle</item>
<!--        <item name="textColorAlertDialogListItem">@color/primary</item>-->
<!--        <item name="android:textColor">@color/white</item>-->
    </style>
    <style name="AppTheme.PreferenceTheme.CategoryStyle" parent="Preference.Category">
        <item name="android:layout">@layout/opoc_pref_category_text</item>
    </style>


    <style name="LightTextToolbarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="android:actionModeBackground">@color/primary_dark</item>
        <item name="actionModeBackground">@color/primary_dark</item>
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="actionMenuTextColor">@android:color/white</item>
        <item name="android:textColorSecondary">@android:color/white</item>
    </style>

    <style name="AppTheme.Light.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <!-- reduced spacing -->
    <style name="MyDialogTheme" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:background">@color/primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondary">@color/white</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="textColorAlertDialogListItem">@color/white</item>
    </style>
    <style name="LessSpaceActionButtonStyle" parent="Widget.AppCompat.ActionButton">
        <item name="android:minWidth">1dip</item>
        <item name="android:paddingLeft">8dip</item>
        <item name="android:paddingRight">8dip</item>
        <item name="android:paddingStart">8dip</item>
        <item name="android:paddingEnd">8dip</item>
    </style>


    <style name="HomeTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">@drawable/home_card_bg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="HomeTileIcon">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:padding">10dp</item>
    </style>
    <style name="HomeTileLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:textColor">@color/home_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/jakarta_bold</item>
    </style>
    <style name="HomeTileSub">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/home_text_dim</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Tool screens (Text Tools, JSON Studio, Templates, Compare) -->
    <style name="ToolBtn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/tool_btn_bg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:maxLines">1</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">10sp</item>
        <item name="autoSizeMaxTextSize">14sp</item>
        <item name="autoSizeStepGranularity">1sp</item>
        <item name="android:textColor">@color/home_text</item>
        <item name="android:fontFamily">@font/jakarta_bold</item>
    </style>
    <style name="ToolBtn.Icon">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_weight">0</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:drawablePadding">0dp</item>
    </style>
    <style name="ToolBtn.Primary">
        <item name="android:background">@drawable/tool_btn_primary_bg</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:layout_weight">1.5</item>
    </style>
    <style name="ToolChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:background">@drawable/tool_chip_bg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/tool_chip_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/jakarta_bold</item>
    </style>
    <style name="ToolSection">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textColor">@color/home_text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">@font/jakarta_extrabold</item>
    </style>
    <style name="ToolSmallLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/home_text_dim</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/jakarta_bold</item>
    </style>
    <style name="ToolInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@null</item>
        <item name="android:gravity">top|start</item>
        <item name="android:inputType">textMultiLine|textNoSuggestions</item>
        <item name="android:textColor">@color/home_text</item>
        <item name="android:textColorHint">@color/tool_mono_dim</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textCursorDrawable">@drawable/cursor_accent</item>
        <item name="android:importantForAutofill">no</item>
    </style>
    <style name="ToolStatTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">72dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:background">@drawable/tool_card</item>
    </style>
    <style name="ToolStatValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/home_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@font/jakarta_extrabold</item>
    </style>
    <style name="ToolStatLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/home_text_dim</item>
        <item name="android:textSize">11sp</item>
    </style>
    <style name="HomeChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:background">@drawable/home_card_bg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="HomeChipIcon">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:padding">8dp</item>
    </style>
    <style name="HomeChipLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">2</item>
        <item name="android:textColor">@color/home_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/jakarta_bold</item>
    </style>
</resources>
